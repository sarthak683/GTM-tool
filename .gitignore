# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/

# Environment and secrets
.env
.env.*
!.env.example

# Python tooling caches and test artifacts
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Build and packaging artifacts
build/
dist/
*.egg-info/

# Logs and runtime files
*.log
celerybeat-schedule
tmp/

# Frontend dependencies and build output
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Deployment handoff files
MAC_DEPLOY_HANDOFF.md

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Per-environment Helm values carry live credentials (inline DB passwords, API
# keys). The chart itself lives in deploy/gtm-chart/; these must never be
# committed. See deploy/README.md.
deploy/**/gtm.yaml
deploy/**/gtm-prod.yaml
deploy/**/values-*.local.yaml

# Claude Code machine-local settings. Never tracked: it accumulates per-machine
# permission rules that have historically embedded live credentials.
.claude/settings.local.json
.codex/

# Prod-repair review exports contain live prospect PII — never commit
scripts/prod-repair/review-*/
